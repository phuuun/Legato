<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing goes with Android's own backup or phone-to-phone transfer: playlists, plays and spots point at
    MediaStore ids, which differ on the new phone, and a copied "already backed up" mark would then let the daily
    backup overwrite Download/Legato backup.json with the broken data. That file is how Legato moves phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
